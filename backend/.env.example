# Copy this file to .env and fill in values

# Postgres connection string
# Local Docker Compose default (host port 55432 to avoid clashing with other local Postgres instances):
DATABASE_URL=postgres://toyswap:toyswap@localhost:55432/toyswap
# Railway injects this automatically when you attach a Postgres service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Set to false to disable SSL (local Docker). Hosted Railway Postgres uses SSL automatically.
DATABASE_SSL=false

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_string

# Optional: if set, real photo condition-assessment via Claude's vision API is used.
# If left empty, the platform falls back to a mock AI evaluator so the app still
# fully works out of the box for local testing.
ANTHROPIC_API_KEY=

# Port the backend listens on
PORT=4000

# Optional override for where uploaded photos are stored (Railway volume mount)
# UPLOADS_DIR=/data/uploads

# Delivery service integration
DELIVERY_API_URL=https://delivery-rabka.up.railway.app/

# Comma-separated parent emails that receive the admin role.
ADMIN_EMAILS=admin@admin.com
# Password for the first ADMIN_EMAILS account (created/updated on startup).
ADMIN_PASSWORD=admin0617

# Default exchange visibility radius in kilometers (admin can change at runtime)
DEFAULT_EXCHANGE_RADIUS_KM=10
